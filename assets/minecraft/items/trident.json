{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "gui",
            "ground",
            "fixed",
            "on_shelf"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/trident"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",
        "on_false": {
          "type": "minecraft:special",
          "base": "minecraft:item/trident_in_hand",
          "model": {
            "type": "minecraft:trident"
          }
        },
        "on_true": {
          "type": "minecraft:special",
          "base": "minecraft:item/trident_throwing",
          "model": {
            "type": "minecraft:trident"
          }
        },
        "transformation": {
          "left_rotation": [
            0.0,
            0.0,
            0.0,
            1.0
          ],
          "right_rotation": [
            0.0,
            0.0,
            0.0,
            1.0
          ],
          "scale": [
            1.0,
            -1.0,
            -1.0
          ],
          "translation": [
            0.0,
            0.0,
            0.0
          ]
        }
      }
    },
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "gui"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/trident"
          }
        },
        {
          "when": [
            "ground",
            "fixed",
            "on_shelf"
          ],
          "model": {
            "type": "minecraft:composite",
            "models": [
              {
                "type": "minecraft:model",
                "model": "minecraft:item/generated/trident_dropped"
              },
              {
                "type": "minecraft:model",
                "model": "minecraft:item/outline/third_person/trident_dropped"
              }
            ]
          }
        },
        {
          "when": [
            "firstperson_righthand",
            "firstperson_lefthand"
          ],
          "model": {
            "type": "minecraft:condition",
            "property": "minecraft:using_item",
            "on_false": {
              "type": "minecraft:composite",
              "models": [
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/generated/trident_in_hand"
                },
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/outline/first_person/trident_in_hand"
                }
              ]
            },
            "on_true": {
              "type": "minecraft:composite",
              "models": [
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/generated/trident_throwing"
                },
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/outline/first_person/trident_throwing"
                }
              ]
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",
        "on_false": {
          "type": "minecraft:composite",
          "models": [
            {
              "type": "minecraft:model",
              "model": "minecraft:item/generated/trident_in_hand"
            },
            {
              "type": "minecraft:model",
              "model": "minecraft:item/outline/third_person/trident_in_hand"
            }
          ]
        },
        "on_true": {
          "type": "minecraft:composite",
          "models": [
            {
              "type": "minecraft:model",
              "model": "minecraft:item/generated/trident_throwing"
            },
            {
              "type": "minecraft:model",
              "model": "minecraft:item/outline/third_person/trident_throwing"
            }
          ]
        }
      }
    },
    "component": "minecraft:enchantments",
    "ignore_default": true
  }
}
