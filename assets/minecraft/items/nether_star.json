{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/nether_star"
        }
      },
      {
        "when": [
          "firstperson_lefthand",
          "firstperson_righthand"
        ],
        "model": {
          "type": "minecraft:composite",
          "models": [
            {
              "type": "minecraft:model",
              "model": "minecraft:item/generated/nether_star"
            },
            {
              "type": "minecraft:model",
              "model": "minecraft:item/outline/first_person/nether_star"
            }
          ]
        }
      }
    ],
    "fallback": {
      "type": "minecraft:composite",
      "models": [
        {
          "type": "minecraft:model",
          "model": "minecraft:item/generated/nether_star"
        },
        {
          "type": "minecraft:model",
          "model": "minecraft:item/outline/third_person/nether_star"
        }
      ]
    }
  }
}
