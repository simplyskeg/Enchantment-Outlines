
{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:has_component",
    "component": "minecraft:enchantments",
    "ignore_default": true,
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": ["gui"],
          "model": {
            "type": "minecraft:select",
            "property": "minecraft:charge_type",
            "cases": [
              {
                "when": "arrow",
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_arrow"
                }
              },
              {
                "when": "rocket",
                "model": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_firework"
                }
              }
            ],
            "fallback": {
              "type": "minecraft:condition",
              "property": "minecraft:using_item",
              "on_false": {
                "type": "minecraft:model",
                "model": "minecraft:item/crossbow"
              },
              "on_true": {
                "type": "minecraft:range_dispatch",
                "property": "minecraft:crossbow/pull",
                "entries": [
                  {
                    "threshold": 0.58,
                    "model": {
                      "type": "minecraft:model",
                      "model": "minecraft:item/crossbow_pulling_1"
                    }
                  },
                  {
                    "threshold": 1.0,
                    "model": {
                      "type": "minecraft:model",
                      "model": "minecraft:item/crossbow_pulling_2"
                    }
                  }
                ],
                "fallback": {
                  "type": "minecraft:model",
                  "model": "minecraft:item/crossbow_pulling_0"
                }
              }
            }
          }
        },
        {
          "when": [
            "firstperson_righthand",
            "firstperson_lefthand"
          ],
          "model": {
            "type": "minecraft:select",
            "property": "minecraft:charge_type",
            "cases": [
              {
                "when": "arrow",
                "model": {
                  "type": "minecraft:composite",
                  "models": [
                    {
                      "type": "minecraft:model",
                      "model": "minecraft:item/generated/crossbow_arrow"
                    },
                    {
                      "type": "minecraft:model",
                      "model": "minecraft:item/outline/first_person/crossbow_arrow"
                    }
                  ]
                }
              },
              {
                "when": "rocket",
                "model": {
                  "type": "minecraft:composite",
                  "models": [
                    {
                      "type": "minecraft:model",
                      "model": "minecraft:item/generated/crossbow_firework"
                    },
                    {
                      "type": "minecraft:model",
                      "model": "minecraft:item/outline/first_person/crossbow_firework"
                    }
                  ]
                }
              }
            ],
            "fallback": {
              "type": "minecraft:condition",
              "property": "minecraft:using_item",
              "on_false": {
                "type": "minecraft:composite",
                "models": [
                  {
                    "type": "minecraft:model",
                    "model": "minecraft:item/generated/crossbow"
                  },
                  {
                    "type": "minecraft:model",
                    "model": "minecraft:item/outline/first_person/crossbow"
                  }
                ]
              },
              "on_true": {
                "type": "minecraft:range_dispatch",
                "property": "minecraft:crossbow/pull",
                "entries": [
                  {
                    "threshold": 0.58,
                    "model": {
                      "type": "minecraft:composite",
                      "models": [
                        {
                          "type": "minecraft:model",
                          "model": "minecraft:item/generated/crossbow_pulling_1"
                        },
                        {
                          "type": "minecraft:model",
                          "model": "minecraft:item/outline/first_person/crossbow_pulling_1"
                        }
                      ]
                    }
                  },
                  {
                    "threshold": 1.0,
                    "model": {
                      "type": "minecraft:composite",
                      "models": [
                        {
                          "type": "minecraft:model",
                          "model": "minecraft:item/generated/crossbow_pulling_2"
                        },
                        {
                          "type": "minecraft:model",
                          "model": "minecraft:item/outline/first_person/crossbow_pulling_2"
                        }
                      ]
                    }
                  }
                ],
                "fallback": {
                  "type": "minecraft:composite",
                  "models": [
                    {
                      "type": "minecraft:model",
                      "model": "minecraft:item/generated/crossbow_pulling_0"
                    },
                    {
                      "type": "minecraft:model",
                      "model": "minecraft:item/outline/first_person/crossbow_pulling_0"
                    }
                  ]
                }
              }
            }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:select",
        "property": "minecraft:charge_type",
        "cases": [
          {
            "when": "arrow",
            "model": {
              "type": "minecraft:composite",
              "models": [
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/generated/crossbow_arrow"
                },
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/outline/third_person/crossbow_arrow"
                }
              ]
            }
          },
          {
            "when": "rocket",
            "model": {
              "type": "minecraft:composite",
              "models": [
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/generated/crossbow_firework"
                },
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/outline/third_person/crossbow_firework"
                }
              ]
            }
          }
        ],
        "fallback": {
          "type": "minecraft:condition",
          "property": "minecraft:using_item",
          "on_false": {
            "type": "minecraft:composite",
            "models": [
              {
                "type": "minecraft:model",
                "model": "minecraft:item/generated/crossbow"
              },
              {
                "type": "minecraft:model",
                "model": "minecraft:item/outline/third_person/crossbow"
              }
            ]
          },
          "on_true": {
            "type": "minecraft:range_dispatch",
            "property": "minecraft:crossbow/pull",
            "entries": [
              {
                "threshold": 0.58,
                "model": {
                  "type": "minecraft:composite",
                  "models": [
                    {
                      "type": "minecraft:model",
                      "model": "minecraft:item/generated/crossbow_pulling_1"
                    },
                    {
                      "type": "minecraft:model",
                      "model": "minecraft:item/outline/third_person/crossbow_pulling_1"
                    }
                  ]
                }
              },
              {
                "threshold": 1.0,
                "model": {
                  "type": "minecraft:composite",
                  "models": [
                    {
                      "type": "minecraft:model",
                      "model": "minecraft:item/generated/crossbow_pulling_2"
                    },
                    {
                      "type": "minecraft:model",
                      "model": "minecraft:item/outline/third_person/crossbow_pulling_2"
                    }
                  ]
                }
              }
            ],
            "fallback": {
              "type": "minecraft:composite",
              "models": [
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/generated/crossbow_pulling_0"
                },
                {
                  "type": "minecraft:model",
                  "model": "minecraft:item/outline/third_person/crossbow_pulling_0"
                }
              ]
            }
          }
        }
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:charge_type",
      "cases": [
        {
          "when": "arrow",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/crossbow_arrow"
          }
        },
        {
          "when": "rocket",
          "model": {
            "type": "minecraft:model",
            "model": "minecraft:item/crossbow_firework"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:condition",
        "property": "minecraft:using_item",
        "on_false": {
          "type": "minecraft:model",
          "model": "minecraft:item/crossbow"
        },
        "on_true": {
          "type": "minecraft:range_dispatch",
          "property": "minecraft:crossbow/pull",
          "entries": [
            {
              "threshold": 0.58,
              "model": {
                "type": "minecraft:model",
                "model": "minecraft:item/crossbow_pulling_1"
              }
            },
            {
              "threshold": 1.0,
              "model": {
                "type": "minecraft:model",
                "model": "minecraft:item/crossbow_pulling_2"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "minecraft:item/crossbow_pulling_0"
          }
        }
      }
    }
  }
}
